{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "jsx": "preserve",
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": false
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts"]
}
