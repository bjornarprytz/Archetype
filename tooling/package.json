{
  "name": "archetype-tooling",
  "version": "0.1.0",
  "description": "Archetype card game authoring tool",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "vite",
    "electron:start": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:sidecar": "dotnet build ../src/Archetype.Tooling.Server/Archetype.Tooling.Server.csproj -c Debug",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^30.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "jsdom": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^4.5.0"
  }
}
