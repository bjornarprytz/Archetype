<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Archetype.Core\Archetype.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>Archetype.Engine</PackageId>
    <Description>Execution engine for Archetype card games — resolves actions, events, and triggers.</Description>
  </PropertyGroup>

  <!-- White-box test access to engine internals (D15) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Archetype.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
