<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Sidecar runs on desktop only — no WASM constraints (D26) -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Self-contained single-file for distribution (D26) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- D26: Tooling.Server references Core, Build, Text — NOT Engine -->
    <ProjectReference Include="..\Archetype.Core\Archetype.Core.csproj" />
    <ProjectReference Include="..\Archetype.Build\Archetype.Build.csproj" />
    <ProjectReference Include="..\Archetype.Text\Archetype.Text.csproj" />
  </ItemGroup>

</Project>
